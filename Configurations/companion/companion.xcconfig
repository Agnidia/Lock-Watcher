//
//  companion.xcconfig
//  iOS companion settings layered over the macOS base.
//

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
LD_RUNPATH_SEARCH_PATHS = @executable_path/Frameworks
PRODUCT_BUNDLE_IDENTIFIER = $(COMPANION_BUNDLE_ID)
INFOPLIST_FILE = Companion/Resources/Info.plist
GENERATE_INFOPLIST_FILE = NO
CODE_SIGN_ENTITLEMENTS = Companion/Resources/Companion.entitlements
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_MODULE_VERIFIER = NO
ASSETCATALOG_COMPILER_APPICON_NAME = icon
