// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

//Packaging
INFOPLIST_FILE = Resources/Info.plist
PRODUCT_BUNDLE_IDENTIFIER = $(APP_DOMAIN).$(APP_NAME)

//Signing
CODE_SIGN_ENTITLEMENTS = Resources/entitlements/Lock_Watcher-non-mas.entitlements
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = YES
ENABLE_OUTGOING_NETWORK_CONNECTIONS = YES
ENABLE_RESOURCE_ACCESS_CAMERA = YES
ENABLE_RESOURCE_ACCESS_LOCATION = YES
ENABLE_RESOURCE_ACCESS_USB = YES
ENABLE_USER_SELECTED_FILES = readwrite

//Deployment
COMBINE_HIDPI_IMAGES = YES
DEVELOPMENT_ASSET_PATHS = "Resources/Preview Content"

//Asset Catalog Compiler - Options
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_APPICON_NAME = icon

//Localization
SWIFT_EMIT_LOC_STRINGS = YES

//Swift Compiler - Custom Flags
OTHER_SWIFT_FLAGS = -DNON_MAS_CONFIG

INFOPLIST_KEY_NSFaceIDUsageDescription = To unlock access to database data
INFOPLIST_KEY_NSCameraUsageDescription = Capture whoever tries to access your Mac, and scan the pairing QR code of your iPhone
INFOPLIST_KEY_NSLocationUsageDescription = Add location information to snapshots and take a snapshot when the Mac moves while locked
