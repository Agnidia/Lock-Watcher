      "product": "Products/XPCMail.xpc",
      "product-type": "xpc-service",
      "last-swift-migration": "12.3",
      "specialized-configurations": [
        { "name": "Debug", "file": { "anchor": "Configurations", "relative-path": "debug.xcconfig" } },
