{
  "organization": "Agnidia",
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": { "anchor": "Configurations", "relative-path": "debug.xcconfig" } },
    { "name": "Release", "file": { "anchor": "Configurations", "relative-path": "release.xcconfig" } },
    { "name": "Release-non-mas", "file": { "anchor": "Configurations", "relative-path": "app/app-release.xcconfig" } },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "uk",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/Agnidia/CameraSnap.git",
      "version": {
        "up-to-next-major-version": "0.3.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/sindresorhus/LaunchAtLogin-Modern",
      "version": {
        "up-to-next-major-version": "1.1.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/dropbox/SwiftyDropbox.git",
      "version": {
        "up-to-next-major-version": "10.2.4",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/onmyway133/EasyStash",
      "version": {
        "up-to-next-major-version": "1.1.9",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/kishikawakatsumi/KeychainAccess",
      "version": {
        "up-to-next-major-version": "4.2.2",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/Agnidia/SimpleTracer",
      "version": {
        "up-to-next-major-version": "0.1.4",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/russell-archer/SKHelper",
      "version": {
        "up-to-next-major-version": "2.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/Agnidia/CustomizedAboutView.git",
      "version": {
        "up-to-next-major-version": "1.1.0",
      },
    },
  ],
  "files": [
    { "kind": "folder", "path": "Shared", "target-membership": [ "Lock-Watcher", "Lock-Watcher-Companion", "Lock-Watcher-non-mas", "Lock-WatcherCompanionTests" ] },
    {
      "kind": "folder",
      "path": "Companion",
      "target-membership": [
        "Lock-Watcher-Companion",
      ],
      "membership-exceptions": [
        {
          "target": "Lock-Watcher-Companion",
          "exclusions": [
            "Resources/Companion.storekit",
            "Resources/Info.plist",
          ],
        }, {
          "target": "Lock-WatcherCompanionTests",
          "inclusions": [
            "Core/AlertInbox.swift",
            "Core/AlertTrigger.swift",
            "Core/CloudPhotoImageDecoder.swift",
            "Core/CloudPhotoLibrary.swift",
            "Core/ICloudPhotoSource.swift",
            "Core/ProEntitlement.swift",
            "Core/PushRegistrationModel.swift",
            "Core/QRCodeRenderer.swift",
            "Preview/PreviewAlerts.swift",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "CompanionTests", "target-membership": [ "Lock-WatcherCompanionTests" ] },
    { "path": "README.md" },
    { "kind": "folder", "path": "Configurations" },
    { "kind": "folder", "path": "Source", "target-membership": [ "Lock-Watcher", "Lock-Watcher-non-mas" ] },
    {
      "kind": "group",
      "path": "Resources",
      "children": [
        {
          "path": "Colors.xcassets",
          "target-membership": [
            "Lock-Watcher-Companion/resources",
            "Lock-Watcher/resources",
            "Lock-Watcher-non-mas/resources",
          ],
        }, {
          "path": "icon.icon",
          "target-membership": [
            "Lock-Watcher-Companion/resources",
            "Lock-Watcher/resources",
            "Lock-Watcher-non-mas/resources",
          ],
        }, {
          "path": "InfoPlist.xcstrings",
          "target-membership": [
            "Lock-Watcher/resources",
            "Lock-Watcher-non-mas/resources",
          ],
        }, {
          "kind": "group",
          "path": "Preview Content",
          "children": [
            {
              "path": "Preview Assets.xcassets",
              "target-membership": [
                "Lock-Watcher-Companion/resources",
                "Lock-Watcher/resources",
                "Lock-Watcher-non-mas/resources",
              ],
            },
          ],
        }, {
          "path": "policy.html",
          "encoding": "utf8",
          "target-membership": [
            "Lock-Watcher/resources",
            "Lock-Watcher-non-mas/resources",
          ],
        }, {
          "kind": "group",
          "path": "entitlements",
          "children": [
            { "path": "XPCAuthentication.entitlements", "encoding": "utf8" },
            { "path": "XPCPower-non-mas.entitlements", "encoding": "utf8" },
            { "path": "Lock_Watcher.entitlements", "encoding": "utf8" },
            { "path": "Lock_Watcher-non-mas.entitlements", "encoding": "utf8" },
            { "path": "XPCMail-non-mas.entitlements", "encoding": "utf8" },
            { "path": "XPCMail.entitlements", "encoding": "utf8" },
            { "path": "XPCPower.entitlements", "encoding": "utf8" },
            { "path": "XPCAuthentication-non-mas.entitlements", "encoding": "utf8" },
          ],
        }, {
          "path": "Localizable.xcstrings",
          "target-membership": [
            "Lock-Watcher/resources",
            "Lock-Watcher-non-mas/resources",
          ],
        }, {
          "path": "PrivacyInfo.xcprivacy",
          "target-membership": [
            "Lock-Watcher/resources",
            "Lock-Watcher-non-mas/resources",
          ],
        }, {
          "path": "Assets.xcassets",
          "target-membership": [
            "Lock-Watcher/resources",
            "Lock-Watcher-non-mas/resources",
          ],
        },
        { "path": "Info.plist", "encoding": "utf8" },
      ],
    }, {
      "kind": "folder",
      "path": "XPCAuthentication",
      "target-membership": [
        "XPCAuthentication",
      ],
      "membership-exceptions": [
        {
          "target": "Lock-Watcher",
          "inclusions": [
            "XPCAuthenticationProtocol.swift",
          ],
        }, {
          "target": "Lock-Watcher-non-mas",
          "inclusions": [
            "XPCAuthenticationProtocol.swift",
          ],
        }, {
          "target": "XPCAuthentication",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "XPCMail",
      "children": [
        { "path": "/System/Applications/Mail.app", "target-membership": [ "XPCMail/resources" ] },
        { "path": "XPCMail.h" },
        { "path": "XPCMail.m", "target-membership": [ "XPCMail/compile-sources" ] },
        { "path": "main.m", "target-membership": [ "XPCMail/compile-sources" ] },
        { "path": "Info.plist" },
        {
          "path": "XPCMailProtocol.swift",
          "target-membership": [
            "Lock-Watcher/compile-sources",
            "Lock-Watcher-non-mas/compile-sources",
            "XPCMail/compile-sources",
          ],
        },
        { "path": "XPCMail-Bridging-Header.h" },
      ],
    }, {
      "kind": "folder",
      "path": "XPCPower",
      "membership-exceptions": [
        {
          "target": "Lock-Watcher",
          "inclusions": [
            "XPCPowerProtocol.swift",
          ],
        }, {
          "target": "Lock-Watcher-non-mas",
          "inclusions": [
            "XPCPowerProtocol.swift",
          ],
        }, {
          "target": "XPCPower",
          "inclusions": [
            "XPCPower.m",
            "XPCPowerProtocol.swift",
            "main.m",
          ],
        },
      ],
    },
    { "path": "Lock-WatcherTests.xctestplan" },
    {
      "kind": "folder",
      "path": "Tests",
      "target-membership": [
        "Lock-WatcherTests",
      ],
      "membership-exceptions": [
        {
          "target": "Lock-Watcher",
          "inclusions": [
            "Coordinator/MainCoordinatorTest.swift",
          ],
        }, {
          "target": "Lock-Watcher-non-mas",
          "inclusions": [
            "Coordinator/MainCoordinatorTest.swift",
          ],
        }, {
          "target": "Lock-WatcherTests",
          "exclusions": [
            "Coordinator/MainCoordinatorTest.swift",
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "UITests",
      "membership-exceptions": [
        {
          "target": "Lock-WatcherUITests",
          "inclusions": [
            "ApplicationUITests.swift",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Lock-Watcher-Companion.app", "id": "C0DE5EED0000000000000007", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Lock-WatcherCompanionTests.xctest", "id": "C0DE5EED000000000000000B", "type": "wrapper.cfbundle", "index": false },
