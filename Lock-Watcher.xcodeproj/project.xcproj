      "name": "XPCMail",
      "id": "A533D82525AA11F40046B7C8",
      "product": "Products/XPCMail.xpc",
      "product-type": "xpc-service",
      "last-swift-migration": "12.3",
      "specialized-configurations": [
        { "name": "Debug", "file": "Configurations/debug.xcconfig" },
        { "name": "Release", "file": "Configurations/release.xcconfig" },
        { "name": "Release-non-mas", "file": "Configurations/release.xcconfig" },
      ],
      "build-phases": [
        "resources",
        "compile-sources",
        "frameworks",
      ],
      "build-rules": [
        {
          "processor": "com.apple.compilers.proxy.script",
          "file-type": "pattern.proxy",
          "file-patterns": "*.app",
          "output-files": [
            "$(DERIVED_FILES_DIR)/$(INPUT_FILE_BASE).h",
          ],
          "script": "sdef \"$INPUT_FILE_PATH\" | sdp -fh -o \"$DERIVED_FILES_DIR\" --basename \"$INPUT_FILE_BASE\" --bundleid `defaults read \"$INPUT_FILE_PATH/Contents/Info\" CFBundleIdentifier`\n",
        },
      ],
      "build-settings": {
        "AUTOMATION_APPLE_EVENTS": "YES",
        "CODE_SIGN_ENTITLEMENTS": "Resources/entitlements/XPCMail-non-mas.entitlements",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "INFOPLIST_FILE": "XPCMail/Info.plist",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.igrsoft.XPCMail",
        "SWIFT_OBJC_BRIDGING_HEADER": "XPCMail/XPCMail-Bridging-Header.h",
      },
    }, {
