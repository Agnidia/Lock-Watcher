    "AlertsEmptyMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts from your Mac appear here."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тут з’являтимуться сповіщення з вашого Mac."
          }
        }
      }
    },
    "AlertsEmptyTitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Alerts"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає сповіщень"
          }
        }
      }
    },
    "PairCodeAccessibility" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairing code"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код під’єднання"
          }
        }
      }
    },
    "PairDenied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are off for Lock-Watcher, so your Mac cannot reach this iPhone. Turn them on in Settings."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сповіщення для Lock-Watcher вимкнено, тому Mac не може зв’язатися з цим iPhone. Увімкніть їх у Параметрах."
          }
        }
      }
    },
    "PairFailed" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone could not register for alerts. Check the network and try again."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей iPhone не зміг зареєструватися для сповіщень. Перевірте мережу і спробуйте ще раз."
          }
        }
      }
    },
    "PairInstructions" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your Mac, open Lock-Watcher Settings, choose Pair iPhone and hold this code in front of the camera."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Mac відкрийте параметри Lock-Watcher, виберіть «Під’єднати iPhone…» і піднесіть цей код до камери."
          }
        }
      }
    },
